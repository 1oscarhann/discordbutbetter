{
  "name": "dbb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dbb/server --filter @dbb/web dev",
    "build": "pnpm --filter @dbb/shared build && pnpm --filter @dbb/web build && pnpm --filter @dbb/server build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "typescript": "5.9.3"
  }
}
