# ---------------------------------------------------------------------------
# Copy to .env and fill in. `sh infra/gen-env.sh chat.example.com` does it for you.
# ---------------------------------------------------------------------------

# Your domain, pointed at this machine (A/AAAA record). Caddy gets the HTTPS certificate.
DOMAIN=chat.example.com

# Shown in the browser tab, emails and invites.
APP_NAME=Haunt

# Long random strings. Generate each with: openssl rand -hex 32
SECRET=change-me-to-64-random-hex-characters-openssl-rand-hex-32-xxxxxxxx
POSTGRES_PASSWORD=change-me
LIVEKIT_API_KEY=chatkey
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters-xxxxxxxx

# Who can sign up: open | invite (needs an instance invite: `docker compose exec app node dist/cli.js create-invite`) | closed
REGISTRATION=open

# Upload limits (no paywall: these are just what your disk/bandwidth can take)
MAX_UPLOAD_MB=100
MAX_AVATAR_MB=15
MAX_EMOJI_KB=1024
EMOJIS_PER_GUILD=250
STICKERS_PER_GUILD=100

# --- Optional: email (verification + password reset). Without it, accounts work immediately
# --- and an admin hands out reset links with `node dist/cli.js reset-link <username>`.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Chat <noreply@chat.example.com>

# --- Optional: game search for "Playing" (pick one). Without it, people type their game in.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# RAWG_API_KEY=

# --- Optional: song search for "Listening to" uses MusicBrainz (no key). Set false to turn it off.
# MUSIC_SEARCH=true

# --- Optional: S3-compatible storage instead of the local volume (Garage, R2, B2, AWS...)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=garage
# S3_BUCKET=chat-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Optional: LiveKit discovers your public IP via STUN. On a LAN-only setup set this to false.
# LIVEKIT_USE_EXTERNAL_IP=true

# --- Optional: only for trying it out without a domain (see README "Local test run").
# PUBLIC_URL=http://localhost
# LIVEKIT_URL=ws://localhost/livekit
